import { useEffect, useState } from "react";

import { PageHeader } from "./components/PageHeader";
import { StatsRow } from "./components/StatsRow";
import { FilterBar } from "./components/FilterBar";
import { StatusMessage } from "./components/StatusMessage";
import { QuakeCard } from "./components/QuakeCard";

import { fetchQuakes } from "./api/quakeApi";
import type { FilterValue, Quake } from "./types";

const MINIMUM_MMI = 3;

function App() {
  // ---------- STATE ----------
  // Four separate pieces of state, each with one job.

  const [quakes, setQuakes] = useState<Quake[]>([]);
  const [activeFilter, setActiveFilter] = useState<FilterValue>("all");
  const [isLoading, setIsLoading] = useState(true);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // ---------- LOADING ----------

  async function loadQuakes() {
    setIsLoading(true);
    setErrorMessage(null);

    try {
      const data = await fetchQuakes(MINIMUM_MMI);
      setQuakes(data);
    } catch (error) {
      console.error(error);
      setQuakes([]);
      setErrorMessage(
        "Could not load earthquakes. Is the API running on port 5055?"
      );
    } finally {
      // finally runs whether it worked or failed, so loading always
      // stops. Without this, a failure would spin forever.
      setIsLoading(false);
    }
  }

  // Run once, when the component first appears on screen.
  useEffect(() => {
    loadQuakes();
  }, []);

  // ---------- DERIVED VALUE ----------
  // Worked out from state on every render. NOT state itself.

  const visibleQuakes =
    activeFilter === "all"
      ? quakes
      : quakes.filter((quake) => quake.severity === activeFilter);

  // ---------- WHAT TO SHOW ----------

  return (
    <>
      <PageHeader
        count={quakes.length}
        isLoading={isLoading}
        onReload={loadQuakes}
      />

      <StatsRow quakes={quakes} />

      <FilterBar activeFilter={activeFilter} onFilterChange={setActiveFilter} />

      <StatusMessage isLoading={isLoading} errorMessage={errorMessage} />

      {!isLoading && errorMessage === null && (
        <section>
          {visibleQuakes.length === 0 ? (
            <p className="empty">No earthquakes in this band.</p>
          ) : (
            visibleQuakes.map((quake) => (
              <QuakeCard key={quake.publicID} quake={quake} />
            ))
          )}
        </section>
      )}
    </>
  );
}

export default App;
